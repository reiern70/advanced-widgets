{
	"name": "@antilia/core",
	"version": "1.0.0-SNAPSHOT",
	"description": "The components of Antilia's Advanced Widgets in plain TypeScript, without a framework",
	"license": "Apache-2.0",
	"author": "Ernesto Reinaldo Barreiro <reiern70@gmail.com> (https://github.com/reiern70)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles/*": "./styles/*"
	},
	"files": [
		"dist",
		"!dist/wicket",
		"styles"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/build-wicket.mjs",
		"test": "tsc --noEmit && vitest run"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.3",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-java": "^6.0.2",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@lezer/common": "^1.5.3",
		"@lezer/highlight": "^1.2.5"
	}
}
