{
	"name": "@antilia/core",
	"version": "1.0.0-SNAPSHOT",
	"description": "The components of Antilia's Advanced Widgets in plain TypeScript, without a framework",
	"license": "UNLICENSED",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles/*": "./styles/*"
	},
	"files": [
		"dist",
		"!dist/wicket",
		"styles"
	],
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node scripts/build-wicket.mjs",
		"test": "tsc --noEmit && vitest run"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "^5.0.3",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
