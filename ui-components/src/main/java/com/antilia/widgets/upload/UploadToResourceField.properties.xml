  All rights reserved.

  The words of the errors of the uploads of an UploadToResourceField, which Wicket's
  FileUploadToResourceField looks for with the limits of the field: ${maxSize}, ${fileMaxSize} and
  ${fileCountMax}. uploadConnectionLost is what the field tells when the request got no answer, the
  server and the progress alike.
-->
<properties>
	<entry key="wicket.no.files.selected">Nothing to upload: no files were chosen.</entry>
	<entry key="uploadTooLarge">The files weigh more than ${maxSize} together, the most sent at once.</entry>
	<entry key="uploadSingleFileTooLarge">A file weighs more than ${fileMaxSize}, the most for a file.</entry>
	<entry key="uploadTooManyFiles">More than ${fileCountMax} files, the most sent at once.</entry>
	<entry key="uploadToResourceFailed">The upload failed.</entry>
	<entry key="uploadConnectionLost">The connection to the server broke off during the upload.</entry>
</properties>
