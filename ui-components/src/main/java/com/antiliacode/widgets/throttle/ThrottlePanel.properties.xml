	<entry key="AjaxDelay.FIVE_SECONDS">5 s</entry>
	<entry key="UploadSpeed.FULL">Full speed</entry>
	<entry key="UploadSpeed.MEGABYTE">1 MB/s</entry>
	<entry key="UploadSpeed.QUARTER_MEGABYTE">256 kB/s</entry>
	<entry key="UploadSpeed.SLOW">64 kB/s</entry>
</properties>
