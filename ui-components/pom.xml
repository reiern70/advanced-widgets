<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.antilia.widgets</groupId>
		<artifactId>antilia-widgets-parent</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>ui-components</artifactId>
	<packaging>jar</packaging>

	<name>Advanced Widgets :: UI Components</name>

	<dependencies>
		<!-- WICKET DEPENDENCIES -->
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-extensions</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-native-websocket-core</artifactId>
		</dependency>

		<!-- JSON DEPENDENCIES (only needed by JacksonJsonSerializer) -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- the container provides it; JsonRowsResource reads the method and body of a request -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- TEST DEPENDENCIES -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>fortawesome__fontawesome-free</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-tester</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<properties>
		<frontend.directory>${project.basedir}/../frontend</frontend.directory>
		<skipTests>false</skipTests>
		<jacoco.minimum.lines>0.90</jacoco.minimum.lines>
		<jacoco.minimum.branches>0.80</jacoco.minimum.branches>
	</properties>

	<build>
		<resources>
			<resource>
				<filtering>false</filtering>
				<directory>src/main/resources</directory>
			</resource>
			<!-- keep Wicket markup (.html, .properties, .css, .js) next to the Java classes -->
			<resource>
				<filtering>false</filtering>
				<directory>src/main/java</directory>
				<includes>
					<include>**</include>
				</includes>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
			<!-- the scripts and style sheets built from frontend/core, see frontend-maven-plugin -->
			<resource>
				<filtering>false</filtering>
				<directory>${frontend.directory}/core/dist/wicket</directory>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<filtering>false</filtering>
				<directory>src/test/resources</directory>
			</testResource>
			<testResource>
				<filtering>false</filtering>
				<directory>src/test/java</directory>
				<includes>
					<include>**</include>
				</includes>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</testResource>
		</testResources>
		<plugins>
			<!--
			  The browser side of the components is built from frontend/, an npm workspace whose core
			  package holds the scripts and style sheets also offered to React and Svelte. The plugin
			  installs its own Node and npm into frontend/node, so the build needs nothing but Maven;
			  the core's build writes the scripts for Wicket into frontend/core/dist/wicket, a
			  resource directory above. -DskipTests skips the tests of the frontend too.
			-->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>2.0.2</version>
				<configuration>
					<workingDirectory>${frontend.directory}</workingDirectory>
					<installDirectory>${frontend.directory}</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<nodeVersion>v24.15.0</nodeVersion>
							<npmVersion>11.12.1</npmVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm-ci</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>ci --no-audit --no-fund</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm-build</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build</arguments>
						</configuration>
					</execution>
					<execution>
						<id>npm-test</id>
						<phase>test</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>test</arguments>
							<skip>${skipTests}</skip>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
			  The production files: next to every script and style sheet, a minified copy named
			  *.min.js and *.min.css, which Wicket serves instead in deployment mode. The scripts are
			  minified and their local names mangled by the Closure Compiler (simple optimizations
			  keep the global names, such as Wicket.Dropdown, the pages call); the style sheets lose
			  their comments and the white space around braces, semicolons and commas.
			-->
			<plugin>
				<groupId>com.github.blutorange</groupId>
				<artifactId>closure-compiler-maven-plugin</artifactId>
				<version>3.1.0</version>
				<configuration>
					<baseSourceDir>${project.build.outputDirectory}</baseSourceDir>
					<baseTargetDir>${project.build.outputDirectory}</baseTargetDir>
					<sourceDir>.</sourceDir>
					<targetDir>.</targetDir>
					<skipMerge>true</skipMerge>
					<outputFilename>#{path}/#{basename}.min.#{extension}</outputFilename>
					<closureCompilationLevel>SIMPLE_OPTIMIZATIONS</closureCompilationLevel>
					<closureLanguageOut>ECMASCRIPT_2020</closureLanguageOut>
					<closureInjectLibraries>false</closureInjectLibraries>
					<closureEmitUseStrict>false</closureEmitUseStrict>
				</configuration>
				<executions>
					<execution>
						<id>minify-js</id>
						<phase>process-resources</phase>
						<goals>
							<goal>minify</goal>
						</goals>
						<configuration>
							<includes>
								<include>**/*.js</include>
							</includes>
							<excludes>
								<exclude>**/*.min.js</exclude>
								<exclude>com/antilia/widgets/codeeditor/antilia-code-editor.js</exclude>
							</excludes>
						</configuration>
					</execution>
					<!--
					  The code editor bundles CodeMirror, whose own code makes the compiler warn on
					  every build: empty branches (if ... ;) and a new RegExp() made only to see whether
					  it throws. Those two checks are off for this bundle only, so that a new warning
					  stands out.
					-->
					<execution>
						<id>minify-code-editor-js</id>
						<phase>process-resources</phase>
						<goals>
							<goal>minify</goal>
						</goals>
						<configuration>
							<includes>
								<include>com/antilia/widgets/codeeditor/antilia-code-editor.js</include>
							</includes>
							<closureWarningLevels>
								<suspiciousCode>OFF</suspiciousCode>
								<uselessCode>OFF</uselessCode>
							</closureWarningLevels>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>minify-css</id>
						<phase>process-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<copy todir="${project.build.outputDirectory}" overwrite="true" encoding="UTF-8">
									<fileset dir="${project.build.outputDirectory}" includes="**/*.css" excludes="**/*.min.css"/>
									<globmapper from="*.css" to="*.min.css"/>
								</copy>
								<!-- comments, then runs of white space, then the white space around { } ; , > -->
								<replaceregexp flags="gs" encoding="UTF-8" match="/\*.*?\*/" replace="">
									<fileset dir="${project.build.outputDirectory}" includes="**/*.min.css"/>
								</replaceregexp>
								<replaceregexp flags="g" encoding="UTF-8" match="\s+" replace=" ">
									<fileset dir="${project.build.outputDirectory}" includes="**/*.min.css"/>
								</replaceregexp>
								<replaceregexp flags="g" encoding="UTF-8" match=" ?([{};,&gt;]) ?" replace="\1">
									<fileset dir="${project.build.outputDirectory}" includes="**/*.min.css"/>
								</replaceregexp>
								<replaceregexp flags="g" encoding="UTF-8" match=";}" replace="}">
									<fileset dir="${project.build.outputDirectory}" includes="**/*.min.css"/>
								</replaceregexp>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- the tests check the license keys, which are not enforced for now, see Licensing -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<antilia-widgets.license.enforced>true</antilia-widgets.license.enforced>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
