# Copied to .env on the server by deploy.sh the first time, readable by its owner alone; fill it in
# and deploy again. Never commit .env. deploy.sh (start.sh) refuses to go on while a value is
# change-me, or JAVA_OPTIONS lack -Dwicket.configuration=deployment, or set
# -Dantilia-widgets.sign-in-as, -Dantilia-widgets.open-demos, or -Dantilia-widgets.open-registration
# to anything but false.

# the domain registered in Lightsail, its A records pointing at the static IP of the instance
DOMAIN=example.com
# Let's Encrypt writes here when a certificate is about to expire
ACME_EMAIL=you@example.com

# 1 GB instance: 512 MB heap leaves room for the OS, Docker and Caddy; 2 GB instance: -Xmx1g.
# A JVM out of memory ends, and Docker starts it again (the image sets it too, in JDK_JAVA_OPTIONS)
JAVA_OPTIONS=-Xmx512m -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -Dwicket.configuration=deployment

# the accounts that may open the demos without registering, e.g. for a client: name:password,
# several separated by commas; visitors sign in with the name. None unless given here; make each
# password up, e.g. with: openssl rand -base64 18. Synced at every start: a changed password takes
# effect, an account taken out is locked (listing it again opens it), so emptying the list locks
# every account it held
ANTILIA_WIDGETS_ACCOUNTS=

# the passwords of the accounts the demo always has: admin (the administrator, on /admin), semedy and
# wicket. Make each up, e.g. with: openssl rand -base64 18. An account without one is not added;
# changing one here and deploying again changes the account's password.
ANTILIA_WIDGETS_ADMIN_PASSWORD=
ANTILIA_WIDGETS_SEMEDY_PASSWORD=
ANTILIA_WIDGETS_WICKET_PASSWORD=

# PostgreSQL, keeping the users and the accesses, in the container compose.yaml runs on the
# instance: the password of its superuser (widgets, or DATABASE_USER), who makes the backups and the
# role of the application; make up a long random one, e.g. with: openssl rand -hex 24
DATABASE_PASSWORD=
# the password of the application's own role (widgets_app, or DATABASE_APP_USER), which is no
# superuser and owns the tables (see database-role.sql); make up another one the same way
DATABASE_APP_PASSWORD=
# or a Lightsail managed database instead: its endpoint, and a role of the application made there
# as database-role.sql does, in DATABASE_APP_USER and DATABASE_APP_PASSWORD
# DATABASE_URL=jdbc:postgresql://ls-xxxx.xxxx.eu-central-1.rds.amazonaws.com:5432/widgets

# the public key the nightly dumps of the database are encrypted to, age1... (see README.md,
# Backups); its private key never comes to this server. Without one the dumps stay plain, and
# backup.log warns about it every night
BACKUP_AGE_RECIPIENT=

# the emails confirming a registration (see README.md, section Email); without SMTP_HOST
# registering is closed. E.g. Amazon SES: the SMTP credentials made in the SES console
# SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIA...
# SMTP_PASSWORD=
# MAIL_FROM=Antilia Widgets <no-reply@example.com>
