# Copy to .env on the server (deploy.sh does it the first time) and fill in. Never commit .env.

# the domain registered in Lightsail, its A records pointing at the static IP of the instance
DOMAIN=example.com
# Let's Encrypt writes here when a certificate is about to expire
ACME_EMAIL=you@example.com

# 1 GB instance: 512 MB heap leaves room for the OS, Docker and Caddy; 2 GB instance: -Xmx1g
JAVA_OPTIONS=-Xmx512m -XX:+UseSerialGC -Dwicket.configuration=deployment

# the accounts that may open the demos without registering, e.g. for a client: name:password,
# several separated by commas; visitors sign in with the name
ANTILIA_WIDGETS_ACCOUNTS=client:change-me

# PostgreSQL, keeping the users and the accesses: the password of the database that compose.yaml
# runs on the instance; make up a long random one, e.g. with: openssl rand -base64 24
DATABASE_PASSWORD=change-me
# or a Lightsail managed database instead: its endpoint, user and password
# DATABASE_URL=postgres://widgets@ls-xxxx.xxxx.eu-central-1.rds.amazonaws.com:5432/widgets
# DATABASE_USER=widgets
