{
	email {$ACME_EMAIL}
}

# www goes to the bare domain
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	# no body larger than the uploads of the demo (20 MB at most, see UploadPage) reaches Jetty:
	# a larger one is answered 413
	request_body {
		max_size 25MB
	}
	encode zstd gzip
	# Jetty takes the address of the client, the host and the scheme from the X-Forwarded-For,
	# -Host and -Proto that Caddy sets, replacing any a client sends. The other headers of the
	# kind that Jetty reads too, which Caddy would pass on as the client sent them, are dropped,
	# so that a client cannot choose the address Jetty sees.
	reverse_proxy app:8080 {
		header_up -Forwarded
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Server
		header_up -X-Proxied-Https
		header_up -Proxy-Auth-Cert
		header_up -Proxy-Ssl-Id
	}
	# HTTPS only from now on, no guessing of types, the address of a page to other sites only
	# as its origin, and no names of servers
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-Via
	}
}
