<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
	version="6.1">

	<display-name>Antilia's Advanced Widgets Demo</display-name>

	<!--
		There are three means to configure Wickets configuration mode and they 
		are tested in the order given.
		
		1) A system property: -Dwicket.configuration 
		2) servlet specific <init-param> 
		3) context specific <context-param>

		The value might be either "development" (reloading when templates change) or
		"deployment". If no configuration is found, "development" is the default. -->

	<!--
		Deployment, as production runs, unless the system property says otherwise: jetty:run and
		Start pass -Dwicket.configuration=development. In development the demos are open to
		everybody and the error pages show stack traces.
	-->
	<context-param>
		<param-name>configuration</param-name>
		<param-value>deployment</param-value>
	</context-param>

	<filter>
		<filter-name>wicket.demo-app</filter-name>
		<!-- JavaxWebSocketFilter is a WicketFilter that also handles websocket upgrade requests -->
		<filter-class>org.apache.wicket.protocol.ws.javax.JavaxWebSocketFilter</filter-class>
		<init-param>
			<param-name>applicationClassName</param-name>
			<param-value>com.antiliacode.widgets.demo.WicketApplication</param-value>
		</init-param>
	</filter>

	<filter-mapping>
		<filter-name>wicket.demo-app</filter-name>
		<url-pattern>/*</url-pattern>
		<!-- the errors too: Jetty's 404 renders Wicket's NotFoundPage, see error-page below -->
		<dispatcher>REQUEST</dispatcher>
		<dispatcher>ERROR</dispatcher>
	</filter-mapping>
	<!-- an address without a page, in the look of the site rather than Jetty's -->
	<error-page>
		<error-code>404</error-code>
		<location>/not-found</location>
	</error-page>

	<!-- a session ends after 5 minutes without a request, see WicketApplication.SESSION_TIMEOUT -->
	<session-config>
		<session-timeout>5</session-timeout>
		<!--
			The cookie is out of reach of the scripts of the page, and goes along with requests
			from other sites only when the user follows a link. Secure it is already, on the
			requests that came over HTTPS.
		-->
		<cookie-config>
			<http-only>true</http-only>
			<attribute>
				<attribute-name>SameSite</attribute-name>
				<attribute-value>Lax</attribute-value>
			</attribute>
		</cookie-config>
		<!-- never ;jsessionid= in the URLs, where links copied and Referers would give it away -->
		<tracking-mode>COOKIE</tracking-mode>
	</session-config>

	<!--
		A folder without a page, such as /images/, answers 403 rather than the list of its files:
		Jetty's default servlet reads its init-param dirAllowed from this context-param too, in
		the image, in jetty:run and in the tests alike.
	-->
	<context-param>
		<param-name>org.eclipse.jetty.servlet.Default.dirAllowed</param-name>
		<param-value>false</param-value>
	</context-param>
</web-app>
