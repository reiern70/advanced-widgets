<properties>
	<entry key="title">Registrarse</entry>
	<entry key="lead">Regístrese para probar las demos de los componentes y enterarse de los nuevos.</entry>
	<entry key="firstName">Nombre</entry>
	<entry key="lastName">Apellido</entry>
	<entry key="email">Correo electrónico</entry>
	<entry key="country">País</entry>
	<entry key="role">Función</entry>
	<entry key="website">Sitio web</entry>
	<entry key="question">¿Cuánto es {0} + {1}?</entry>
	<entry key="answer">La suma</entry>
	<entry key="submit">Registrarse</entry>
	<entry key="robot">Eso no parecía una persona rellenando el formulario. Calcule la nueva suma y vuelva a enviarlo.</entry>
	<entry key="role.developer">Desarrollador</entry>
	<entry key="role.architect">Arquitecto</entry>
	<entry key="role.designer">Diseñador</entry>
	<entry key="role.manager">Gerente</entry>
	<entry key="role.student">Estudiante</entry>
	<entry key="role.other">Otra</entry>
	<entry key="Required">Indique ${label}.</entry>
	<entry key="EmailAddressValidator">${label} no es una dirección de correo válida.</entry>
	<entry key="password">Contraseña</entry>
	<entry key="repeatedPassword">Repita la contraseña</entry>
	<entry key="taken">Ya hay una cuenta con este correo. Inicie sesión con ella o regístrese con otro correo.</entry>
	<entry key="StringValidator.minimum">${label} necesita al menos ${minimum} caracteres.</entry>
	<entry key="EqualPasswordInputValidator">Las contraseñas no coinciden.</entry>
	<entry key="closed">El registro aún no está disponible. Vuelva más tarde, o inicie sesión si ya tiene una cuenta.</entry>
</properties>
