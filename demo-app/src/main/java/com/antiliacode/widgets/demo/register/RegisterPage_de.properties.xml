<properties>
	<entry key="title">Registrieren</entry>
	<entry key="lead">Registrieren Sie sich, um die Demos der Komponenten auszuprobieren. Wir senden Ihnen einen Link, um Ihre E-Mail-Adresse zu bestätigen.</entry>
	<entry key="firstName">Vorname</entry>
	<entry key="lastName">Nachname</entry>
	<entry key="email">E-Mail</entry>
	<entry key="country">Land</entry>
	<entry key="website">Webseite</entry>
	<entry key="question">Wie viel ist {0} + {1}?</entry>
	<entry key="answer">Die Summe</entry>
	<entry key="submit">Registrieren</entry>
	<entry key="robot">Das sah nicht nach einem Menschen aus, der das Formular ausfüllt. Bitte rechnen Sie die neue Summe aus und senden Sie es erneut.</entry>
	<entry key="Required">${label} ist ein Pflichtfeld.</entry>
	<entry key="EmailAddressValidator">${label} ist keine gültige E-Mail-Adresse.</entry>
	<entry key="password">Passwort</entry>
	<entry key="repeatedPassword">Passwort wiederholen</entry>
	<entry key="EqualPasswordInputValidator">Die Passwörter stimmen nicht überein.</entry>
	<entry key="closed">Die Registrierung ist vorerst geschlossen. Bitte schauen Sie später wieder vorbei, oder melden Sie sich an, wenn Sie schon ein Konto haben.</entry>
	<entry key="emailLanguage">Sprache der E-Mails</entry>
	<entry key="passwordHint">Mindestens 10 Zeichen, mit Groß- und Kleinbuchstaben, einer Ziffer und einem Sonderzeichen.</entry>
	<entry key="StrongPasswordValidator">${label} braucht ${minimum} bis ${maximum} Zeichen, mit einem Groß- und einem Kleinbuchstaben, einer Ziffer und einem Sonderzeichen.</entry>
	<entry key="PasswordNotEmailValidator">Das Passwort darf Ihre E-Mail-Adresse nicht enthalten.</entry>
	<entry key="jobRole">Rolle</entry>
	<entry key="jobRoleOther">Ihre Rolle</entry>
	<entry key="JobRole.DEVELOPER">Entwickler</entry>
	<entry key="JobRole.ARCHITECT">Architekt</entry>
	<entry key="JobRole.DESIGNER">Designer</entry>
	<entry key="JobRole.MANAGER">Manager</entry>
	<entry key="JobRole.STUDENT">Student</entry>
	<entry key="JobRole.OTHER">Andere</entry>
	<entry key="tooMany">Gerade gibt es zu viele Registrierungen. Bitte versuchen Sie es in einer Stunde noch einmal.</entry>
</properties>
