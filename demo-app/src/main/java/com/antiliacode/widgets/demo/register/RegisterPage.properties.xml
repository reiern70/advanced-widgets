<properties>
	<entry key="title">Register</entry>
	<entry key="lead">Register to try the demos of the components. We email you a link to confirm your address.</entry>
	<entry key="firstName">First name</entry>
	<entry key="lastName">Last name</entry>
	<entry key="email">Email</entry>
	<entry key="country">Country</entry>
	<entry key="website">Website</entry>
	<entry key="question">What is {0} + {1}?</entry>
	<entry key="answer">The sum</entry>
	<entry key="submit">Register</entry>
	<entry key="robot">That did not look like a person filling in the form. Please work out the new sum and send it again.</entry>
	<entry key="Required">${label} is required.</entry>
	<entry key="EmailAddressValidator">${label} is not a valid email address.</entry>
	<entry key="password">Password</entry>
	<entry key="repeatedPassword">Password again</entry>
	<entry key="taken">There is an account with this email already. Sign in with it, or register with another email.</entry>
	<entry key="EqualPasswordInputValidator">The passwords are not the same.</entry>
	<entry key="closed">Registering is closed for now. Please come back later, or sign in if you already have an account.</entry>
	<entry key="emailLanguage">Language of the emails</entry>
	<entry key="passwordHint">At least 10 characters, with upper and lower case letters, a digit and a symbol.</entry>
	<entry key="StrongPasswordValidator">${label} needs ${minimum} to ${maximum} characters, with an upper and a lower case letter, a digit and a symbol.</entry>
	<entry key="PasswordNotEmailValidator">The password must not contain your email.</entry>
	<entry key="jobRole">Role</entry>
	<entry key="jobRoleOther">Your role</entry>
	<entry key="JobRole.DEVELOPER">Developer</entry>
	<entry key="JobRole.ARCHITECT">Architect</entry>
	<entry key="JobRole.DESIGNER">Designer</entry>
	<entry key="JobRole.MANAGER">Manager</entry>
	<entry key="JobRole.STUDENT">Student</entry>
	<entry key="JobRole.OTHER">Other</entry>
	<entry key="tooMany">Too many registrations right now. Please try again in an hour.</entry>
</properties>
