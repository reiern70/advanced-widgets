<properties>
	<entry key="captchaLead">Too many failed attempts: type the letters of the image too.</entry>
	<entry key="captchaQuestionLead">Too many failed attempts: answer the question too.</entry>
	<entry key="captchaLetters">The letters of the image</entry>
	<entry key="captchaImage">Letters to type</entry>
	<entry key="captchaAnother">Show other letters</entry>
	<entry key="captchaToQuestion">Hard to read? Answer a question instead</entry>
	<entry key="captchaToLetters">Type the letters of an image instead</entry>
	<entry key="captchaAnswer">The answer</entry>
	<entry key="captchaPlus">How much is {0} plus {1}? Write it in digits.</entry>
	<entry key="captchaMinus">How much is {0} minus {1}? Write it in digits.</entry>
	<entry key="captchaNumbers">zero, one, two, three, four, five, six, seven, eight, nine, ten</entry>
	<entry key="captchaLettersWrong">The letters are not those of the image. Try the new ones.</entry>
	<entry key="captchaAnswerWrong">The answer is wrong. Try the new question.</entry>
</properties>
