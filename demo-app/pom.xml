<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.antiliacode.widgets</groupId>
		<artifactId>antilia-widgets-parent</artifactId>
		<version>${revision}</version>
	</parent>

	<artifactId>demo-app</artifactId>
	<packaging>war</packaging>

	<name>Advanced Widgets Demo</name>

	<dependencies>
		<dependency>
			<groupId>com.antiliacode.widgets</groupId>
			<artifactId>ui-components</artifactId>
		</dependency>
		<!-- the method and the body of the requests to the team resource; Jetty provides it -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- WICKET DEPENDENCIES -->
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-extensions</artifactId>
		</dependency>
		<!-- JSR-356 (jakarta.websocket) implementation of Wicket native websockets -->
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-native-websocket-javax</artifactId>
		</dependency>

		<!--
		  DATABASE: the users and the accesses, with Spring Data JPA on Hibernate; PostgreSQL in
		  production, H2 when no database is configured (see Database); Flyway makes the tables
		-->
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-orm</artifactId>
		</dependency>
		<dependency>
			<groupId>org.hibernate.orm</groupId>
			<artifactId>hibernate-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.zaxxer</groupId>
			<artifactId>HikariCP</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
		</dependency>

		<!-- MAIL: the email confirming a registration, over SMTP when it is configured (see SmtpMailer) -->
		<dependency>
			<groupId>org.eclipse.angus</groupId>
			<artifactId>angus-mail</artifactId>
		</dependency>

		<!-- JSON: the rows of a JsonBasedDynamicDataTable are serialized by JacksonJsonSerializer -->
		<dependency>
			<groupId>tools.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- ICONS: read by SvgIcon and served by FontAwesomeResourceReference -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>fortawesome__fontawesome-free</artifactId>
		</dependency>

		<!-- STYLE: the style sheet of Bootstrap, served by BootstrapResourceReference -->
		<dependency>
			<groupId>org.webjars.npm</groupId>
			<artifactId>bootstrap</artifactId>
		</dependency>

		<!-- LOGGING DEPENDENCIES - SLF4J-SIMPLE -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-simple</artifactId>
		</dependency>

		<!-- JUNIT DEPENDENCY FOR TESTING -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-params</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- browser tests, run with -Pselenium -->
		<dependency>
			<groupId>org.seleniumhq.selenium</groupId>
			<artifactId>selenium-java</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-tester</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.wicket</groupId>
			<artifactId>wicket-native-websocket-tester</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- JETTY DEPENDENCIES FOR TESTING (see Start.java) -->
		<dependency>
			<groupId>org.eclipse.jetty</groupId>
			<artifactId>jetty-server</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jetty.ee11</groupId>
			<artifactId>jetty-ee11-webapp</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jetty</groupId>
			<artifactId>jetty-jmx</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.eclipse.jetty.ee11.websocket</groupId>
			<artifactId>jetty-ee11-websocket-jakarta-server</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<properties>
		<!-- jetty:run runs in development; -Dwicket.configuration=deployment runs it as production does -->
		<wicket.configuration>development</wicket.configuration>
		<!-- the account every session of jetty:run is signed in with; -Dantilia-widgets.sign-in-as= to sign in yourself -->
		<antilia-widgets.sign-in-as>admin</antilia-widgets.sign-in-as>
		<frontend.directory>${project.basedir}/../frontend</frontend.directory>
		<!-- without -Pselenium the browser tests are skipped, so these hold for the plain build -->
		<jacoco.minimum.lines>0.75</jacoco.minimum.lines>
		<jacoco.minimum.branches>0.65</jacoco.minimum.branches>
		<!-- the release profile publishes the library only -->
		<maven.source.skip>true</maven.source.skip>
		<maven.javadoc.skip>true</maven.javadoc.skip>
		<gpg.skip>true</gpg.skip>
	</properties>

	<build>
		<resources>
			<resource>
				<filtering>false</filtering>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<filtering>false</filtering>
				<directory>src/main/java</directory>
				<includes>
					<include>**</include>
				</includes>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
			<!-- react-demo.js and svelte-demo.js of the FrameworkTabs, built from frontend/demo -->
			<resource>
				<filtering>false</filtering>
				<directory>${frontend.directory}/demo/dist</directory>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<filtering>false</filtering>
				<directory>src/test/resources</directory>
			</testResource>
			<testResource>
				<filtering>false</filtering>
				<directory>src/test/java</directory>
				<includes>
					<include>**</include>
				</includes>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</testResource>
		</testResources>
		<plugins>
			<!--
			  Builds the React and Svelte demos of the FrameworkTabs from frontend/demo, with the Node
			  and the packages ui-components installed and built; so build demo-app together with
			  ui-components (-am).
			-->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<version>2.0.2</version>
				<configuration>
					<workingDirectory>${frontend.directory}</workingDirectory>
					<installDirectory>${frontend.directory}</installDirectory>
				</configuration>
				<executions>
					<execution>
						<id>install-node-and-npm</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>install-node-and-npm</goal>
						</goals>
						<configuration>
							<nodeVersion>v24.15.0</nodeVersion>
							<npmVersion>11.12.1</npmVersion>
						</configuration>
					</execution>
					<execution>
						<id>npm-build-demo</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>npm</goal>
						</goals>
						<configuration>
							<arguments>run build:demo</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!--
			  The branch and commit the application is built from, in build-info.properties on the
			  class path; the footer shows them when the demo runs with -Dwicket.demo=true. Plain
			  git commands in the directory being built, so a linked worktree reports its own
			  branch; without git the values stay empty and the footer shows nothing.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>build-info</id>
						<phase>process-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<exec executable="git" dir="${project.basedir}" outputproperty="build.branch" errorproperty="build.branch.error" failifexecutionfails="false" failonerror="false">
									<arg value="rev-parse"/>
									<arg value="--abbrev-ref"/>
									<arg value="HEAD"/>
								</exec>
								<exec executable="git" dir="${project.basedir}" outputproperty="build.commit" errorproperty="build.commit.error" failifexecutionfails="false" failonerror="false">
									<arg value="rev-parse"/>
									<arg value="--short"/>
									<arg value="HEAD"/>
								</exec>
								<exec executable="git" dir="${project.basedir}" outputproperty="build.changes" errorproperty="build.changes.error" failifexecutionfails="false" failonerror="false">
									<arg value="status"/>
									<arg value="--porcelain"/>
									<arg value="--untracked-files=no"/>
								</exec>
								<condition property="build.dirty" value="true" else="false">
									<length string="${build.changes}" when="greater" length="0"/>
								</condition>
								<property name="build.branch" value=""/>
								<property name="build.commit" value=""/>
								<propertyfile file="${project.build.outputDirectory}/build-info.properties" comment="The branch and commit the demo is built from">
									<entry key="branch" value="${build.branch}"/>
									<entry key="commit" value="${build.commit}"/>
									<entry key="dirty" value="${build.dirty}"/>
								</propertyfile>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
			</plugin>
			<!-- the tests share an H2 database in memory, in PostgreSQL mode, see Database -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<antilia-widgets.database.url>jdbc:h2:mem:widgets;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;DB_CLOSE_DELAY=-1</antilia-widgets.database.url>
						<!-- the passwords of the accounts the demo always has, for the tests: see TestDatabase -->
						<antilia-widgets.admin.password>admin-test-password</antilia-widgets.admin.password>
						<antilia-widgets.semedy.password>semedy-test-password</antilia-widgets.semedy.password>
						<antilia-widgets.wicket.password>wicket-test-password</antilia-widgets.wicket.password>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<!-- jetty:run, with Jakarta websockets, which the plugin of ee11 brings along -->
			<plugin>
				<groupId>org.eclipse.jetty.ee11</groupId>
				<artifactId>jetty-ee11-maven-plugin</artifactId>
				<configuration>
					<systemProperties>
						<maven.project.build.directory.test-classes>${project.build.directory}/test-classes</maven.project.build.directory.test-classes>
						<!-- development, while web.xml says deployment for production -->
						<wicket.configuration>${wicket.configuration}</wicket.configuration>
						<!-- locally nobody signs in: every session is the administrator's, see WicketApplication -->
						<antilia-widgets.sign-in-as>${antilia-widgets.sign-in-as}</antilia-widgets.sign-in-as>
						<!-- locally registering is open, and the emails go to the log, see RegisterPage -->
						<antilia-widgets.open-registration>true</antilia-widgets.open-registration>
					</systemProperties>
					<!-- jetty-ssl.xml resolves the keystore against jetty.base: make it work from the parent directory too -->
					<jettyProperties>
						<jetty.base>${project.basedir}</jetty.base>
					</jettyProperties>
					<jettyXmls>
						<jettyXml>${project.basedir}/src/test/jetty/jetty.xml</jettyXml>
						<jettyXml>${project.basedir}/src/test/jetty/jetty-ssl.xml</jettyXml>
						<jettyXml>${project.basedir}/src/test/jetty/jetty-http.xml</jettyXml>
						<jettyXml>${project.basedir}/src/test/jetty/jetty-https.xml</jettyXml>
					</jettyXmls>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<!-- Runs the browser tests, which need Chrome and Firefox installed. -->
			<id>selenium</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<wicket.selenium>true</wicket.selenium>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
